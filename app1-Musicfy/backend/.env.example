# Configuración del Servicio de IA (Google AI Studio / Gemini o OpenRouter)
# Consigue tu clave gratuita en: https://aistudio.google.com/
GEMINI_API_KEY=tu_clave_de_api_aqui

# Endpoint oficial de Google compatible con OpenAI
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_MODEL=gemini-3.5-flash-lite

# Configuración de CORS (orígenes separados por comas)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Parámetros y límites
MAX_CARACTERES=500
AI_TIMEOUT_SECONDS=25
MAX_TOKENS=600
